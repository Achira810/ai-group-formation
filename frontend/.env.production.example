# =========================================================
# Production Environment Variables Template (Vercel Hosting)
# =========================================================
#
# IMPORTANT FOR VERCEL DEPLOYMENT:
# In Vercel, do NOT commit production .env files to Git.
# Instead, add these variables in the Vercel Dashboard:
#   1. Go to your Project in Vercel: Settings -> Environment Variables
#   2. Add the two variables below:
#      - Key: VITE_SUPABASE_URL
#        Value: https://udtajzpgrgltkdvcvttm.supabase.co (or your production project URL)
#        Target: Production (and Preview if needed)
#      - Key: VITE_SUPABASE_ANON_KEY
#        Value: sb_publishable_zB1s-1CQvxmfXz_YwK0yCg_nWlgY2mg (or your production anon key)
#        Target: Production (and Preview if needed)
#   3. Trigger a redeploy to apply the variables.
# =========================================================

# Production Supabase Project URL
VITE_SUPABASE_URL=https://your-production-project-id.supabase.co

# Production Supabase Anonymous Publishable Key
VITE_SUPABASE_ANON_KEY=your-production-supabase-anon-key
