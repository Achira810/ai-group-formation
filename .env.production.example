# =========================================================
# Production Environment Variables Template (Vercel Hosting)
# =========================================================
#
# HOW TO CONFIGURE ON VERCEL:
# 1. Open your Vercel project at https://vercel.com/dashboard
# 2. Go to Settings -> Environment Variables
# 3. Add the following variables:
#    - VITE_SUPABASE_URL = (your Supabase project URL)
#    - VITE_SUPABASE_ANON_KEY = (your Supabase anon public API key)
# 4. Select environments: Production, Preview, Development
# 5. Click Save and deploy!
# =========================================================

VITE_SUPABASE_URL=https://your-production-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-supabase-anon-key
